# --- Supabase project settings (Project Settings -> API) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-KEEP-SECRET>
SUPABASE_JWT_SECRET=<jwt-secret-from-api-settings>
SUPABASE_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# --- App ---
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed origins (no brackets/quotes needed):
# CORS_ORIGINS=https://your-frontend.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=http://localhost:5173"]

# --- Account lockout policy ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Rate limiting ---
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_PASSWORD_RESET=5/minute
